# ─────────────────────────────────────────────────────────────
#  AI Study · BFF 服务端环境变量
#  复制本文件为 .env 后填入真实值（.env 已被 gitignore，不会提交）
# ─────────────────────────────────────────────────────────────

# 服务端口
PORT=3001

# ══════════════════════════════════════════════════════════════
#  数据库配置
# ══════════════════════════════════════════════════════════════

# 数据库驱动：sqlite（默认）或 postgres
#   sqlite    : 零依赖，直接用，适合开发快速跑通
#   postgres  : 生产推荐，需要安装 PostgreSQL + pgvector 扩展
DATABASE_DRIVER=sqlite

# PostgreSQL 连接串（仅 DATABASE_DRIVER=postgres 时使用）
# 格式：postgresql://user:password@host:port/database
# 本地默认：postgresql://postgres:postgres@localhost:5432/ai_study
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_study

# SQLite 数据库路径（仅 DATABASE_DRIVER=sqlite 时使用，默认 data/knowledge.db）
# DB_PATH=./data/knowledge.db

# ══════════════════════════════════════════════════════════════
#  AI 接口配置
# ══════════════════════════════════════════════════════════════

# AI 接口基础 URL（兼容 OpenAI 协议的厂商均可）
#   智谱 AI     : https://open.bigmodel.cn/api/paas/v4
#   OpenAI      : https://api.openai.com/v1
#   阿里通义    : https://dashscope.aliyuncs.com/compatible-mode/v1
#   火山方舟    : https://ark.cn-beijing.volces.com/api/v3
AI_API_URL=https://open.bigmodel.cn/api/paas/v4

# AI 接口密钥（⚠️ 不要提交到 git！如果之前提交过请立即 regenerate）
AI_API_KEY=your-api-key-here

# 对话模型（对应 AI_API_URL 厂商提供的模型 ID）
#   智谱示例：glm-4-flash / glm-4-plus / glm-4
AI_MODEL=glm-4-flash

# 向量嵌入模型（用于 RAG 知识库检索）
#   智谱示例：embedding-3 / embedding-2
#   如果 AI_API_URL 和 Embedding 厂商不同，可另加 EMBEDDING_API_URL / EMBEDDING_API_KEY
EMBEDDING_MODEL=embedding-3

# ══════════════════════════════════════════════════════════════
#  调试 & 降级（可选）
# ══════════════════════════════════════════════════════════════

# 强制 mock Embedding 模式（不调 API，纯本地 hash 向量）
# 适合：Embedding API 余额耗尽时让 RAG 功能继续跑（检索精度下降）
# ENABLE_MOCK_EMBEDDING=1

# 禁用 Embedding 自动降级（API 失败直接 throw）
# 适合：生产严格模式，不允许 silently fallback
# DISABLE_EMBEDDING_FALLBACK=1

# 服务启动时自动打开调试页面（默认关闭）
# Server 端 → 自动打开 /api/logs-view（实时日志）
# Electron 端 → 自动打开 DevTools
# 本地开发不想每次弹浏览器/DevTools — 默认关
# 线上仓库/分享给别人方便调试 — 设为 1
# AUTO_OPEN_DEBUG_PAGES=1
