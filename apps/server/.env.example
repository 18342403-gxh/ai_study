# ─────────────────────────────────────────────────────────────
#  AI Study · BFF 服务端环境变量
#  复制本文件为 .env 后填入真实值（.env 已被 gitignore，不会提交）
# ─────────────────────────────────────────────────────────────

# 服务端口
PORT=3001

# 监听地址（默认只监听本机回环；对外提供服务时显式设为 0.0.0.0）
HOST=127.0.0.1

# CORS 白名单（逗号分隔）。留空时仅允许 localhost / 127.0.0.1 的任意端口
# CORS_ORIGINS=http://localhost:3003,https://your-domain.com

# ══════════════════════════════════════════════════════════════
#  数据库配置
# ══════════════════════════════════════════════════════════════

# PostgreSQL + pgvector 连接串（必填，所有环境唯一数据库配置）
# 格式：postgresql://user:password@host:port/database
# 本地开发可先执行 docker compose up -d postgres，再执行 pnpm --filter @ai-study/server db:init
DATABASE_URL=postgresql://ai_study:123456@localhost:5432/ai_study

# 旧版 SQLite 数据仅在初始化后的空库中迁移一次：
# pnpm --filter @ai-study/server migrate:sqlite -- --from ./data/knowledge.db

# ══════════════════════════════════════════════════════════════
#  AI 接口配置
# ══════════════════════════════════════════════════════════════

# AI 接口基础 URL（兼容 OpenAI 协议的厂商均可）
#   智谱 AI     : https://open.bigmodel.cn/api/paas/v4
#   OpenAI      : https://api.openai.com/v1
#   阿里通义    : https://dashscope.aliyuncs.com/compatible-mode/v1
#   火山方舟    : https://ark.cn-beijing.volces.com/api/v3
AI_API_URL=https://open.bigmodel.cn/api/paas/v4

# AI 接口密钥（⚠️ 不要提交到 git！如果之前提交过请立即 regenerate）
AI_API_KEY=your-api-key-here

# 对话模型（对应 AI_API_URL 厂商提供的模型 ID）
#   智谱示例：glm-4-flash / glm-4-plus / glm-4
AI_MODEL=glm-4-flash

# 向量嵌入模型（用于 RAG 知识库检索）
#   智谱示例：embedding-3 / embedding-2
#   如果 AI_API_URL 和 Embedding 厂商不同，可另加 EMBEDDING_API_URL / EMBEDDING_API_KEY
EMBEDDING_MODEL=embedding-3

# ══════════════════════════════════════════════════════════════
#  账号与登录
# ══════════════════════════════════════════════════════════════

# 超管首次启动时创建；数据库只保存密码哈希，已存在则不会覆盖密码
# ⚠️ 必须是强口令，禁止使用示例值或默认弱口令
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# 临时账号有效期（小时）
TEMP_ACCOUNT_TTL_HOURS=24

# 超管登录态有效期（天）；临时账号取与自身到期时间的较小值
AUTH_SESSION_TTL_DAYS=7

# 登录 Cookie 名称（一般无需修改）
# AUTH_COOKIE_NAME=ais_session

# 是否允许公开申请临时账号（true=任何人可直接申请，false=仅超管可生成）
ALLOW_PUBLIC_TEMP_APPLY=true

# ══════════════════════════════════════════════════════════════
#  常用工具 Agent（搜索 / 时间 / 计算 / 网页 / 天气 / 新闻）
# ══════════════════════════════════════════════════════════════

# 默认开启；设为 0 可恢复不调用工具的纯模型对话
ENABLE_TOOLS=1
TOOL_MAX_ITERATIONS=4
TOOL_HTTP_TIMEOUT_MS=15000

# bing：免密钥 Bing RSS（默认）；zhipu：智谱付费搜索；auto：智谱失败后降级 Bing
SEARCH_PROVIDER=bing
# 仅智谱搜索使用：search_std / search_pro / search_pro_sogou / search_pro_quark
SEARCH_ENGINE=search_std

# ══════════════════════════════════════════════════════════════
#  学习页 · GitHub 项目检索
# ══════════════════════════════════════════════════════════════

# 可选。不配置时走匿名额度（10 次/分钟，按服务器出口 IP 全站共享）；
# 配置后走认证额度（5000 次/小时）。只需 public repo 读权限，无需任何 scope。
# GITHUB_TOKEN=ghp_xxx

# 单次 GitHub 请求超时（毫秒），超时后前端展示专用提示（当前不启用 Gitee 兜底）
# GITHUB_TIMEOUT_MS=5000

# ══════════════════════════════════════════════════════════════
#  长期规划（默认开启）
# ══════════════════════════════════════════════════════════════

# AI 生成长期规划入口：默认开启；设为 0 仅关闭 AI 入口，手动新建/编辑规划仍可用
# ENABLE_PLAN_AI=0

# ══════════════════════════════════════════════════════════════
#  安全边界 & 模型路由（P0 默认值，一般无需改动）
# ══════════════════════════════════════════════════════════════

# 出站 URL 守卫：1 开启（默认）；0 仅关闭 DNS 私网解析（协议/凭据仍校验）
# URL_GUARD=1

# 工具结果注入守卫：1 开启（默认）；0 关闭
# TOOL_GUARD=1

# 上下文分区预算（个人记录 50% / 资料 35% / 汇总 15%）：1 开启（默认）；0 回退旧顺序注入
# CONTEXT_SECTION_BUDGET=1

# 规则版模型路由：1 开启（默认）；0 关闭并回退调用点原档位
# LLM_ROUTER=1

# 大模型档位（tier=large 时使用；未配置则回退 AI_MODEL）
# AI_MODEL_LARGE=glm-4-plus

# ══════════════════════════════════════════════════════════════
#  OpenTelemetry 追踪（默认关闭）
# ══════════════════════════════════════════════════════════════

# OTEL_ENABLED=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_SERVICE_NAME=ai-study-server
# 采样率（0~1，默认 1）
# OTEL_TRACES_SAMPLER_ARG=0.1

# ══════════════════════════════════════════════════════════════
#  调试 & 降级（可选）
# ══════════════════════════════════════════════════════════════

# 强制 mock Embedding 模式（不调 API，纯本地 hash 向量）
# 适合：Embedding API 余额耗尽时让 RAG 功能继续跑（检索精度下降）
# ENABLE_MOCK_EMBEDDING=1

# 禁用 Embedding 自动降级（API 失败直接 throw）
# 适合：生产严格模式，不允许 silently fallback
# DISABLE_EMBEDDING_FALLBACK=1

# 服务启动时自动打开调试页面（默认关闭）
# Server 端 → 自动打开 /api/logs-view（实时日志）
# Electron 端 → 自动打开 DevTools
# 本地开发不想每次弹浏览器/DevTools — 默认关
# 线上仓库/分享给别人方便调试 — 设为 1
# AUTO_OPEN_DEBUG_PAGES=1
