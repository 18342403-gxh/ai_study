{
  "name": "ai-frontend-lab",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "前端 AI 应用开发学习项目",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd server && npm run dev",
    "dev:all": "concurrently -n front,server -c blue,green \"npm run dev\" \"npm run dev:server\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/ --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "check": "npm run lint && npm run build"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.2.6",
    "antd-mobile": "5.38.1",
    "antd-mobile-icons": "0.3.0",
    "better-sqlite3": "11.1.2",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "highlight.js": "11.11.1",
    "multer": "1.4.5-lts.1",
    "pdf-parse": "1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "10.1.0",
    "react-redux": "9.1.2",
    "react-router-dom": "7.16.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "10.4.20",
    "concurrently": "8.2.2",
    "postcss": "8.4.41",
    "tailwindcss": "3.4.10",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
