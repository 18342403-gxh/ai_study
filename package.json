{
  "name": "ai-study-monorepo",
  "private": true,
  "version": "0.0.1",
  "description": "前端 AI 应用开发学习项目 - Monorepo（React + Vue3 + Node BFF）",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --parallel --filter @ai-study/server --filter @ai-study/generator dev",
    "dev:server": "pnpm --filter @ai-study/server dev",
    "dev:generator": "pnpm --filter @ai-study/generator dev",
    "dev:react": "pnpm --filter @ai-study/web-react dev",
    "dev:vue": "pnpm --filter @ai-study/web-vue dev",
    "dev:ssr": "pnpm --filter @ai-study/web-vue-nuxt dev",
    "dev:all": "pnpm --parallel --filter @ai-study/server --filter @ai-study/generator --filter @ai-study/web-react --filter @ai-study/web-vue --filter @ai-study/web-vue-nuxt dev",
    "build": "pnpm -r --filter @ai-study/shared --filter @ai-study/web-react --filter @ai-study/web-vue --filter @ai-study/web-vue-nuxt --filter @ai-study/server build",
    "build:shared": "pnpm --filter @ai-study/shared build",
    "build:react": "pnpm --filter @ai-study/web-react build",
    "build:vue": "pnpm --filter @ai-study/web-vue build",
    "build:ssr": "pnpm --filter @ai-study/web-vue-nuxt build",
    "build:server": "pnpm --filter @ai-study/server build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint \"{apps,packages}/**/*.{ts,tsx,vue}\"",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,tsx,vue,md,json}\"",
    "check:readme": "node scripts/check-readme-needs-update.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.14.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.11.0",
    "prettier": "3.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "pnpm": {
    "overrides": {
      "nuxi": "3.13.2",
      "unplugin": "1.16.1"
    }
  }
}
