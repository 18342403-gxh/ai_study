{
  "enabled": true,
  "name": "保存时 Lint 检查",
  "description": "当 TypeScript/TSX 文件被编辑时，自动运行 ESLint 检查该文件是否符合编码规约",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.ts",
      "*.tsx"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npx eslint --ext .ts,.tsx --max-warnings 5 ${file}"
  }
}